# Contact form delivery (Resend)
#
# Copy this file to .env.local for local development, and set the same three
# values in the Vercel project under Settings → Environment Variables.
# .env.local is gitignored; never commit a real key.

# From https://resend.com/api-keys. Sending permission is all it needs.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Where submitted messages are delivered.
CONTACT_TO_EMAIL=you@example.com

# Who they come from.
#
# Optional. Defaults to Resend's shared sender, onboarding@resend.dev, which
# needs no domain set up but will ONLY deliver to the address that owns the
# Resend account — so CONTACT_TO_EMAIL must be that address until a domain is
# verified. Once one is, set this to an address on it and mail can go anywhere.
# CONTACT_FROM_EMAIL="Lespa Portfolio <hello@lespa.dev>"

# Optional. Points the send at a different endpoint, so the delivery path can be
# exercised against a local stand-in without sending real mail. Leave unset in
# every real environment.
# RESEND_API_URL=http://localhost:9999/emails
